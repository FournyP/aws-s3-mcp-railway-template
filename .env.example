# Gateway service ----------------------------------------------------------
# Required. Comma-separated list of allowed bearer tokens. Clients must send:
#   Authorization: Bearer <one of these keys>
# Allowed characters per key: A-Z a-z 0-9 . _ ~ + / = -
API_KEYS=

# Optional. Defaults match the template's internal wiring; only override if
# you rename the mcp service.
# MCP_HOST=aws-s3-mcp.railway.internal
# MCP_PORT=3000

# Optional. Port nginx listens on. Pinned to 80 by the IaC file; Railway
# injects a random value when unset, which must then match the domain's
# target port.
# PORT=80

# Optional. `true` also accepts the key as a path segment: /k/<key>/mcp
# MCP clients that cannot send an Authorization header need this.
# PATH_KEY_AUTH=false

# MCP service --------------------------------------------------------------
# Required. Credentials for your S3-compatible storage. For a Railway Bucket,
# reference the bucket's AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required. Comma-separated allowlist of bucket names the MCP server may
# access. Empty exposes no buckets at all.
S3_BUCKETS=

# Optional. Region of the target buckets. `auto` for a Railway Bucket
# (reference its AWS_DEFAULT_REGION), an AWS region otherwise.
# AWS_REGION=us-east-1

# Optional. S3 endpoint URL for non-AWS storage. For a Railway Bucket,
# reference the bucket's AWS_ENDPOINT_URL. Leave unset for real AWS.
# AWS_ENDPOINT=

# Optional. Maximum number of buckets the list-buckets tool returns.
# S3_MAX_BUCKETS=5

# Optional. Port the MCP server listens on. Pinned to 3000 by the IaC file so
# the gateway's MCP_PORT cannot drift from it.
# PORT=3000
